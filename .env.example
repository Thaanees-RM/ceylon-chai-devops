# Used by `docker compose up` to fill in ${VAR} references in docker-compose.yml.
# Copy this file to `.env` (gitignored) and fill in real values -- never commit
# the real .env file.

# First-boot admin account for the admin panel at /admin.html.
# Pick a strong, unique username/password -- see backend/.env.example for the
# password policy the server enforces.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign admin session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
