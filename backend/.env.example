PORT=5000
HOST=0.0.0.0
MONGODB_URI=mongodb://mongodb:27017/chaiDB
CORS_ORIGIN=*
API_MAX_JSON_SIZE=1mb
MAX_IMAGE_SIZE_BYTES=5242880

# Admin authentication
# Required to create the admin account on first boot. Pick a strong, unique
# username/password now -- the server hashes ADMIN_PASSWORD with bcrypt and
# never stores or logs the plaintext. These two vars are only read once, the
# very first time the server starts and finds no admin account in the
# database; change them here has no effect afterwards (use the in-app
# "Change Password" screen, or the recovery flow, to update it later).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secret used to sign admin session tokens (JWT). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left unset, the server generates a random secret at boot, which means
# every restart invalidates all logged-in admin sessions -- fine for local
# dev, not recommended for a real deployment.
JWT_SECRET=
# How long an admin login session stays valid.
JWT_EXPIRES_IN=12h
